{
  "name": "local-cast-prototype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "npm run dev:web",
    "generation:trace": "node dist-server/generationTrace.js",
    "dev:web": "vite --port=3000 --host=0.0.0.0",
    "dev:api": "NODE_ENV=development LOCALCAST_RUNTIME_MODE=development LOCALCAST_PROCESS_ROLE=app tsx server/index.ts",
    "dev:worker": "NODE_ENV=development LOCALCAST_RUNTIME_MODE=development LOCALCAST_PROCESS_ROLE=worker tsx server/worker.ts",
    "dev:all": "sh -c 'npm run dev:api & api_pid=$!; npm run dev:worker & worker_pid=$!; trap \"kill $api_pid $worker_pid 2>/dev/null\" INT TERM EXIT; npm run dev:web'",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "backup:create": "node dist-server/backup.js",
    "backup:restore": "node dist-server/restore.js",
    "start:app": "LOCALCAST_PROCESS_ROLE=app node dist-server/index.js",
    "start:worker": "LOCALCAST_PROCESS_ROLE=worker node dist-server/worker.js",
    "storage:init": "LOCALCAST_PROCESS_ROLE=storage-init node dist-server/storageInit.js",
    "podcast:token:create": "node scripts/create-podcast-token.mjs --output .secrets/podcast-token",
    "podcast:canary:verify": "node scripts/verify-podcast-canary.mjs",
    "podcast:canary:scan": "node scripts/scan-podcast-canary.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server",
    "lint": "tsc --noEmit",
    "test": "NODE_ENV=test LOCALCAST_RUNTIME_MODE=test DATABASE_PATH=:memory: MEDIA_PATH=/tmp/localcast-vitest-media vitest run tests/unit",
    "test:integration": "NODE_ENV=test LOCALCAST_RUNTIME_MODE=test DATABASE_PATH=:memory: MEDIA_PATH=/tmp/localcast-vitest-media vitest run tests/integration",
    "test:e2e": "playwright test",
    "e2e:server": "node scripts/start-e2e-server.mjs",
    "e2e:generation-server": "node scripts/start-e2e-generation-server.mjs",
    "e2e:chat-server": "E2E_GENERATION_PORT=43185 E2E_FEED_PORT=43186 node scripts/start-e2e-generation-server.mjs",
    "e2e:strict-web": "LOCALCAST_VITE_API_TARGET=http://127.0.0.1:43185 vite --port=43189 --host=127.0.0.1",
    "e2e:retry-server": "E2E_GENERATION_PORT=43183 E2E_FEED_PORT=43184 LOCALCAST_FAKE_PHASE_DELAY_MS=150 LOCALCAST_FAKE_FAILURE_PHASE=drafting LOCALCAST_FAKE_FAILURE_ATTEMPT=1 node scripts/start-e2e-generation-server.mjs",
    "smoke:api": "node scripts/smoke-api.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "smoke:compose": "node scripts/smoke-compose.mjs",
    "verify:live-browser": "node scripts/verify-live-sample.mjs",
    "verify": "npm run lint && npm run test && npm run test:integration && npm run build && npm run test:e2e && npm run smoke:api && npm run smoke:production && npm run smoke:compose"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.5",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "react-router-dom": "^7.18.2",
    "rss-parser": "^3.13.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "postcss": "8.5.25"
  }
}
