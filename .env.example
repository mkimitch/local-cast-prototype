# Required by compose.yml. Replace the placeholder values before any deployment.
LOCALCAST_INSTALLATION_ID=replace-with-a-unique-installation-id
LOCALCAST_TRUSTED_ORIGINS=https://localcast.example.lan
PUBLIC_BASE_URL=https://localcast.example.lan

# Generate this ignored mode-600 file with `npm run podcast:token:create`.
# The file is mounted read-only into the app; its value never enters Compose env.
LOCALCAST_PODCAST_TOKEN_SOURCE=./.secrets/podcast-token

# The real walking skeleton uses the approved OpenAI pair. Keep the key only in
# an ignored mode-600 .env file; Compose injects it into the worker only.
TEXT_PROVIDER=openai
SPEECH_PROVIDER=openai
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
OPENAI_SPEECH_VOICE=marin
OPENAI_SPEECH_FORMAT=mp3
# OPENAI_API_KEY=store-only-in-the-untracked-.env-file

# Optional local image label. The base Compose file publishes no host port.
LOCALCAST_IMAGE_TAG=prototype
# Comma-separated exact hostnames/IPs for explicitly trusted private/LAN RSS feeds.
# Link-local and metadata destinations remain blocked. Private feed material is not
# sent to OpenAI under the default cloud-processing consent.
LOCALCAST_RSS_PRIVATE_HOSTS=
